# Markyos environment variables.
#
# Copy to `.env.local` and fill in.

# --- Payments ---------------------------------------------------------------
# Stripe checkout and webhook verification run on the Django backend.
# Configure STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET in that service.
# The frontend only needs NEXT_PUBLIC_API_URL below.

# --- Storage ----------------------------------------------------------------
# Cloudflare R2, replacing the prototype's IndexedDB blob store.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Auth -------------------------------------------------------------------
# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Backend API ------------------------------------------------------------
# The Markyos backend (markyos-backend, Django). Leave unset to keep the
# browser-only build: accounts and brands stay in this browser, and the demo
# login works. Set it to sign up and log in against the server instead.
#
# Three environments, one value each:
#   local    .env.local                     http://localhost:8010/api/v1
#   staging  Vercel → Preview, branch       https://api-staging.markyos.com/api/v1
#            release/staging-v1 (served at app-staging.markyos.com)
#   prod     Vercel → Production, main      https://api.markyos.com/api/v1
#            (served at app.markyos.com)
# NEXT_PUBLIC_* values are baked in at build time, so changing one in Vercel
# needs a redeploy.
# NEXT_PUBLIC_API_URL="http://localhost:8010/api/v1"

# --- Continue with Google ----------------------------------------------------
# The Google Cloud OAuth client id (the backend's GOOGLE_CLIENT_ID, same value).
# Unset keeps the Google button switched off. Needs NEXT_PUBLIC_API_URL too.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"

# --- Made with Markyos badge ---------------------------------------------------
# Where the badge's "Learn about Markyos" link goes (the marketing site; /ar or
# /en is added). Default https://markyos.com. The badge itself is switched on
# per page type by the backend's MADE_WITH_BADGE.
# NEXT_PUBLIC_MARKETING_URL="https://markyos.com"
