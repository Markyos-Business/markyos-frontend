# Markyos environment variables.
#
# Copy to `.env` and fill in. Prisma reads `.env`, not `.env.local`, so the
# database URLs live there; Next.js reads both.

# --- Database (MVP Foundation) ---------------------------------------------
# Postgres. Host is still an open decision between Neon and Supabase — either
# works, and Neon is the leaner fit because Better Auth handles authentication,
# which would leave Supabase Auth unused.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Prisma Migrate diffs against a scratch database. Neon and Supabase both want
# this named explicitly rather than created on the fly.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE_shadow?sslmode=require"

# --- Payments ---------------------------------------------------------------
# Stripe is the only payment rail. Test mode keys until launch.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Storage ----------------------------------------------------------------
# Cloudflare R2, replacing the prototype's IndexedDB blob store.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Auth -------------------------------------------------------------------
# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Backend API ------------------------------------------------------------
# The Markyos backend (markyos-backend, Django). Leave unset to keep the
# browser-only build: accounts and brands stay in this browser, and the demo
# login works. Set it to sign up and log in against the server instead.
#
# Three environments, one value each:
#   local    .env.local                     http://localhost:8010/api/v1
#   staging  Vercel → Preview, branch       https://staging-api.markyos.com/api/v1
#            release/staging-v1 (served at app-staging.markyos.com)
#   prod     Vercel → Production, main      https://api.markyos.com/api/v1
#            (served at app.markyos.com)
# NEXT_PUBLIC_* values are baked in at build time, so changing one in Vercel
# needs a redeploy.
# NEXT_PUBLIC_API_URL="http://localhost:8010/api/v1"
