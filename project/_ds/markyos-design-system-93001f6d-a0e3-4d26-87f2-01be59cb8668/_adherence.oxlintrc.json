{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/charts/**",
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "components/kit-aliases/**",
              "components/navigation/**",
              "components/widgets/**",
              "ui_kits/markyos-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Bricolage Grotesque Condensed|Lato|Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Bricolage Grotesque Condensed, Lato, Source Sans 3."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|meta|media|tone|key|ref|className|style|children)$/]",
        "message": "<ActivityRow> doesn't accept that prop. Declared props: icon, title, meta, media, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|green|red|yellow)$/]",
        "message": "<ActivityRow> tone must be one of 'primary' | 'green' | 'red' | 'yellow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|disabled|key|ref|className|style|children)$/]",
        "message": "<ArrowButton> doesn't accept that prop. Declared props: variant, icon, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline)$/]",
        "message": "<ArrowButton> variant must be one of 'primary' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: shape, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:oval|round)$/]",
        "message": "<Badge> shape must be one of 'oval' | 'round'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|red|yellow|primary|grey)$/]",
        "message": "<Badge> tone must be one of 'green' | 'red' | 'yellow' | 'primary' | 'grey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarGraph'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|series|action|height|key|ref|className|style|children)$/]",
        "message": "<BarGraph> doesn't accept that prop. Declared props: title, description, series, action, height."
