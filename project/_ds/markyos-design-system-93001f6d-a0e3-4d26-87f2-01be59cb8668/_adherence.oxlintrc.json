        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconStyle'] > Literal[value!=/^(?:solid|regular|brand)$/]",
        "message": "<Button> iconStyle must be one of 'solid' | 'regular' | 'brand'."
