# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the template of required variable names carries no secrets and is the
# only record of what a new machine needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch (debug scripts, screenshots, logs)
/_*.mjs
/_*.png
*.log

# vitest reporter output, written by `vitest run --reporter=json`
/.vitest

# The Prisma client, written by `npm run db:generate` into the path the
# generator block names. Generated from schema.prisma on every install, so
# committing it means reviewing thousands of lines nobody wrote and risking a
# client that disagrees with the schema beside it.
/lib/generated

# Playwright
/e2e/test-results/
/e2e/playwright-report/
